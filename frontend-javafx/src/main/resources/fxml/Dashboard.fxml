<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartkneeoa.frontend.controllers.DashboardController"
      styleClass="base-pane" prefWidth="1200" prefHeight="750">

    <!-- ═══ SIDEBAR ═══════════════════════════════════════════════ -->
    <VBox styleClass="sidebar" spacing="0">
        <!-- Logo Header -->
        <VBox styleClass="sidebar-header" spacing="4">
            <Label text="🦵 SmartKneeOA" styleClass="sidebar-logo-text"/>
            <Label text="Assessment System" styleClass="sidebar-subtitle"/>
        </VBox>

        <!-- Navigation -->
        <VBox spacing="0" style="-fx-padding: 12 0 0 0;" VBox.vgrow="ALWAYS">
            <Button text="📊  Dashboard"        onAction="#navDashboard"   styleClass="nav-button, nav-button-active" id="btn-nav-dashboard"/>
            <Button text="➕  New Assessment"   onAction="#navNewAssessment" styleClass="nav-button" id="btn-nav-new"/>
            <Button text="📡  Live Monitor"     onAction="#navLiveMonitor"  styleClass="nav-button" id="btn-nav-monitor"/>
            <Button text="📋  History"          onAction="#navHistory"      styleClass="nav-button" id="btn-nav-history"/>
            <Button text="📄  Reports"          onAction="#navReports"      styleClass="nav-button" id="btn-nav-reports"/>
            <Button text="👤  Profile"          onAction="#navProfile"      styleClass="nav-button" id="btn-nav-profile"/>
            <Button text="⚙️   Settings"        onAction="#navSettings"     styleClass="nav-button" id="btn-nav-settings"/>
        </VBox>

        <!-- Sensor Status -->
        <VBox style="-fx-padding: 16;" spacing="6">
            <Label text="SENSOR STATUS" styleClass="label-muted"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Circle fx:id="bleStatusDot" radius="5" styleClass="sensor-dot-offline"/>
                <Label fx:id="bleStatusLabel" text="Disconnected" styleClass="label-primary"/>
            </HBox>
        </VBox>

        <!-- Logout -->
        <VBox style="-fx-padding: 0 0 16 0;">
            <Separator styleClass="separator"/>
            <Button text="🚪  Sign Out" onAction="#logout"
                    styleClass="nav-button" style="-fx-text-fill: #F44336;"/>
        </VBox>
    </VBox>

    <!-- ═══ MAIN CONTENT ══════════════════════════════════════════ -->
    <VBox HBox.hgrow="ALWAYS" spacing="0">

        <!-- Top Bar -->
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <Label text="Dashboard" styleClass="top-bar-title" HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" text="Welcome, User" styleClass="body-text"/>
        </HBox>

        <!-- Scrollable Content -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
            <VBox spacing="24" style="-fx-padding: 28;">

                <!-- ── Stat Cards Row ── -->
                <HBox spacing="18">
                    <!-- Total Assessments -->
                    <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="TOTAL ASSESSMENTS" styleClass="card-title"/>
                        <Label fx:id="totalAssessments" text="—" styleClass="card-value"/>
                        <Label text="All time" styleClass="label-muted"/>
                    </VBox>

                    <!-- Latest Risk -->
                    <VBox styleClass="card, card-accent" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="LATEST RISK CATEGORY" styleClass="card-title"/>
                        <Label fx:id="latestRisk" text="—" styleClass="card-value"/>
                        <Label text="Most recent assessment" styleClass="label-muted"/>
                    </VBox>

                    <!-- Sensor Status Card -->
                    <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="SENSOR CONNECTION" styleClass="card-title"/>
                        <Label fx:id="sensorStatus" text="Offline" styleClass="card-value"/>
                        <Button text="Connect" onAction="#connectSensor"
                                styleClass="btn-secondary" style="-fx-padding: 6 16;"/>
                    </VBox>

                    <!-- Latest Assessment Date -->
                    <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="LAST ASSESSMENT" styleClass="card-title"/>
                        <Label fx:id="lastAssessmentDate" text="—" styleClass="card-value"
                               style="-fx-font-size: 16px;"/>
                        <Label text="Date" styleClass="label-muted"/>
                    </VBox>
                </HBox>

                <!-- ── Quick Action Buttons ── -->
                <HBox spacing="14">
                    <Button text="➕  Start New Assessment" onAction="#navNewAssessment"
                            styleClass="btn-primary" style="-fx-font-size: 14px; -fx-padding: 14 28;"/>
                    <Button text="📡  Open Live Monitor" onAction="#navLiveMonitor"
                            styleClass="btn-secondary" style="-fx-font-size: 14px; -fx-padding: 14 28;"/>
                    <Button text="📄  View Reports" onAction="#navReports"
                            styleClass="btn-secondary" style="-fx-font-size: 14px; -fx-padding: 14 28;"/>
                </HBox>

                <!-- ── Recent History Table ── -->
                <VBox styleClass="card" spacing="14">
                    <Label text="Recent Assessment History" styleClass="section-title"/>
                    <TableView fx:id="recentHistoryTable" prefHeight="280"
                               style="-fx-background-color: transparent;" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colDate"   text="Date"          prefWidth="160"/>
                            <TableColumn fx:id="colSide"   text="Knee Side"     prefWidth="100"/>
                            <TableColumn fx:id="colPain"   text="Pain Score"    prefWidth="100"/>
                            <TableColumn fx:id="colRisk"   text="Risk Category" prefWidth="140"/>
                            <TableColumn fx:id="colStatus" text="Status"        prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>

        <!-- Status Bar -->
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="20">
            <Label text="Smart Knee OA Assessment System  |  v1.0.0"
                   styleClass="status-text"/>
            <Label text="⚠️ For educational/demonstration use only – not for clinical diagnosis"
                   style="-fx-text-fill: #FF9800; -fx-font-size: 11px;"/>
        </HBox>
    </VBox>
</HBox>
