<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartkneeoa.frontend.controllers.NewAssessmentController"
      styleClass="base-pane" prefWidth="1200" prefHeight="750">

    <!-- Sidebar -->
    <VBox styleClass="sidebar" spacing="0">
        <VBox styleClass="sidebar-header" spacing="4">
            <Label text="🦵 SmartKneeOA" styleClass="sidebar-logo-text"/>
            <Label text="Assessment System" styleClass="sidebar-subtitle"/>
        </VBox>
        <VBox spacing="0" style="-fx-padding: 12 0 0 0;" VBox.vgrow="ALWAYS">
            <Button text="📊  Dashboard"      onAction="#navDashboard"     styleClass="nav-button"/>
            <Button text="➕  New Assessment" onAction="#navNewAssessment" styleClass="nav-button, nav-button-active"/>
            <Button text="📡  Live Monitor"   onAction="#navLiveMonitor"   styleClass="nav-button"/>
            <Button text="📋  History"        onAction="#navHistory"        styleClass="nav-button"/>
            <Button text="📄  Reports"        onAction="#navReports"        styleClass="nav-button"/>
            <Button text="👤  Profile"        onAction="#navProfile"        styleClass="nav-button"/>
            <Button text="⚙️   Settings"      onAction="#navSettings"       styleClass="nav-button"/>
        </VBox>
        <VBox style="-fx-padding: 0 0 16 0;">
            <Separator/>
            <Button text="🚪  Sign Out" onAction="#logout" styleClass="nav-button" style="-fx-text-fill: #F44336;"/>
        </VBox>
    </VBox>

    <!-- Main Content -->
    <VBox HBox.hgrow="ALWAYS" spacing="0">
        <HBox styleClass="top-bar" alignment="CENTER_LEFT">
            <Label text="New Assessment" styleClass="top-bar-title" HBox.hgrow="ALWAYS"/>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
            <VBox spacing="24" style="-fx-padding: 28;">

                <!-- ── Step Indicator ── -->
                <HBox spacing="0" alignment="CENTER" style="-fx-padding: 0 0 10 0;">
                    <Label fx:id="step1Label" text="① Patient Info"
                           style="-fx-text-fill: #00BFA5; -fx-font-weight: 700; -fx-padding: 8 24;
                                  -fx-background-color: rgba(0,191,165,0.12); -fx-background-radius: 20 0 0 20;"/>
                    <Label text="→" style="-fx-text-fill: #5A7A96; -fx-padding: 8 8;"/>
                    <Label fx:id="step2Label" text="② Collect Data"
                           style="-fx-text-fill: #5A7A96; -fx-font-weight: 600; -fx-padding: 8 24;
                                  -fx-background-color: rgba(42,74,107,0.30);"/>
                    <Label text="→" style="-fx-text-fill: #5A7A96; -fx-padding: 8 8;"/>
                    <Label fx:id="step3Label" text="③ Results"
                           style="-fx-text-fill: #5A7A96; -fx-font-weight: 600; -fx-padding: 8 24;
                                  -fx-background-color: rgba(42,74,107,0.30); -fx-background-radius: 0 20 20 0;"/>
                </HBox>

                <!-- ── Step 1: Patient Info ── -->
                <VBox fx:id="step1Pane" styleClass="card" spacing="20">
                    <Label text="Patient &amp; Symptom Information" styleClass="section-title"/>

                    <HBox spacing="20">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Knee Side" styleClass="form-label"/>
                            <ComboBox fx:id="kneeSide" promptText="Select side"
                                      style="-fx-pref-width: 200px;" styleClass="combo-box"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Pain Score (0 = None, 10 = Severe)" styleClass="form-label"/>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Slider fx:id="painSlider" min="0" max="10" value="0"
                                        majorTickUnit="1" minorTickCount="0" snapToTicks="true"
                                        showTickLabels="true" showTickMarks="true"
                                        prefWidth="300"/>
                                <Label fx:id="painScoreLabel" text="0" styleClass="card-value"
                                       style="-fx-font-size: 22px; -fx-min-width: 36px;"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <VBox spacing="6">
                        <Label text="Describe Symptoms (optional)" styleClass="form-label"/>
                        <TextArea fx:id="symptomsField"
                                  promptText="e.g. Pain on walking, stiffness in the morning, swelling..."
                                  prefRowCount="3" styleClass="text-area"
                                  wrapText="true"/>
                    </VBox>

                    <HBox spacing="12" style="-fx-padding: 4 0 0 0;">
                        <Button text="Next: Collect Sensor Data →" onAction="#proceedToStep2"
                                styleClass="btn-primary" style="-fx-padding: 12 28;"/>
                    </HBox>
                </VBox>

                <!-- ── Step 2: Sensor Collection ── -->
                <VBox fx:id="step2Pane" spacing="20" visible="false" managed="false">
                    <VBox styleClass="card" spacing="16">
                        <Label text="Sensor Data Collection" styleClass="section-title"/>
                        <Label text="Connect the ESP32 sensor system, then start the guided movement assessment."
                               styleClass="body-text" wrapText="true"/>

                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Label text="ESP32 Status:" styleClass="form-label"/>
                            <Label fx:id="esp32Status" text="Not connected" styleClass="body-text"/>
                            <Button text="Check Connection" onAction="#checkConnection"
                                    styleClass="btn-secondary" style="-fx-padding: 8 16;"/>
                        </HBox>

                        <HBox spacing="14">
                            <Button fx:id="startCollectionBtn" text="▶  Start Collection (30 sec)"
                                    onAction="#startCollection" styleClass="btn-primary"
                                    style="-fx-padding: 12 24;"/>
                            <Button fx:id="stopCollectionBtn" text="⏹  Stop"
                                    onAction="#stopCollection" styleClass="btn-danger"
                                    style="-fx-padding: 12 24;" disable="true"/>
                        </HBox>

                        <VBox spacing="4">
                            <Label fx:id="collectionStatus" text="Waiting to start..." styleClass="body-text"/>
                            <ProgressBar fx:id="collectionProgress" progress="0"
                                         prefWidth="600" prefHeight="10"/>
                            <Label fx:id="readingCountLabel" text="Readings collected: 0"
                                   styleClass="label-muted"/>
                        </VBox>
                    </VBox>

                    <HBox spacing="12">
                        <Button text="← Back" onAction="#backToStep1" styleClass="btn-secondary"
                                style="-fx-padding: 12 24;"/>
                        <Button fx:id="analyzeBtn" text="Analyze &amp; Get Results →"
                                onAction="#analyze" styleClass="btn-primary"
                                style="-fx-padding: 12 28;" disable="true"/>
                    </HBox>
                </VBox>

                <!-- ── Error / Status ── -->
                <Label fx:id="errorLabel" text="" wrapText="true"
                       style="-fx-text-fill: #F44336; -fx-font-size: 13px;"/>

            </VBox>
        </ScrollPane>

        <HBox styleClass="status-bar" alignment="CENTER_LEFT">
            <Label text="New Assessment  |  Smart Knee OA" styleClass="status-text"/>
        </HBox>
    </VBox>
</HBox>
