<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartkneeoa.frontend.controllers.ReportsController"
      styleClass="base-pane" prefWidth="1200" prefHeight="750">

    <VBox styleClass="sidebar" spacing="0">
        <VBox styleClass="sidebar-header" spacing="4">
            <Label text="🦵 SmartKneeOA" styleClass="sidebar-logo-text"/>
            <Label text="Assessment System" styleClass="sidebar-subtitle"/>
        </VBox>
        <VBox spacing="0" style="-fx-padding: 12 0 0 0;" VBox.vgrow="ALWAYS">
            <Button text="📊  Dashboard"      onAction="#navDashboard"     styleClass="nav-button"/>
            <Button text="➕  New Assessment" onAction="#navNewAssessment" styleClass="nav-button"/>
            <Button text="📡  Live Monitor"   onAction="#navLiveMonitor"   styleClass="nav-button"/>
            <Button text="📋  History"        onAction="#navHistory"       styleClass="nav-button"/>
            <Button text="📄  Reports"        onAction="#navReports"       styleClass="nav-button, nav-button-active"/>
            <Button text="👤  Profile"        onAction="#navProfile"       styleClass="nav-button"/>
            <Button text="⚙️   Settings"      onAction="#navSettings"      styleClass="nav-button"/>
        </VBox>
        <VBox style="-fx-padding: 0 0 16 0;">
            <Separator/>
            <Button text="🚪  Sign Out" onAction="#logout" styleClass="nav-button" style="-fx-text-fill: #F44336;"/>
        </VBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS" spacing="0">
        <HBox styleClass="top-bar" alignment="CENTER_LEFT">
            <Label text="Reports" styleClass="top-bar-title" HBox.hgrow="ALWAYS"/>
            <Button text="📥  Export Summary PDF" onAction="#exportSummaryPdf"
                    styleClass="btn-primary" style="-fx-padding: 8 20;"/>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
            <VBox spacing="24" style="-fx-padding: 24;">

                <!-- Disclaimer -->
                <VBox styleClass="disclaimer-box">
                    <Label text="⚠️ All risk estimates shown are PRELIMINARY DEMONSTRATION RESULTS generated by a model trained on SYNTHETIC data. They are NOT clinically validated and must NOT be used for medical diagnosis."
                           styleClass="disclaimer-text" wrapText="true"/>
                </VBox>

                <!-- Summary Cards -->
                <HBox spacing="16">
                    <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="6" alignment="CENTER">
                        <Label text="TOTAL" styleClass="card-title"/>
                        <Label fx:id="totalCount" text="0" styleClass="card-value"/>
                        <Label text="Assessments" styleClass="label-muted"/>
                    </VBox>
                    <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="6" alignment="CENTER">
                        <Label text="LOW RISK" styleClass="card-title"/>
                        <Label fx:id="lowCount" text="0" styleClass="card-value"
                               style="-fx-text-fill: #4CAF50;"/>
                    </VBox>
                    <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="6" alignment="CENTER">
                        <Label text="MODERATE RISK" styleClass="card-title"/>
                        <Label fx:id="modCount" text="0" styleClass="card-value"
                               style="-fx-text-fill: #FF9800;"/>
                    </VBox>
                    <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="6" alignment="CENTER">
                        <Label text="HIGH RISK" styleClass="card-title"/>
                        <Label fx:id="highCount" text="0" styleClass="card-value"
                               style="-fx-text-fill: #F44336;"/>
                    </VBox>
                </HBox>

                <!-- Charts Row -->
                <HBox spacing="16">
                    <!-- Risk distribution pie chart -->
                    <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="Risk Category Distribution" styleClass="section-title"/>
                        <PieChart fx:id="riskPieChart" prefHeight="220" animated="false"
                                  styleClass="chart" labelsVisible="true"/>
                    </VBox>

                    <!-- Assessments over time line chart -->
                    <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="Assessments Over Time" styleClass="section-title"/>
                        <LineChart fx:id="timelineChart" prefHeight="220" animated="false"
                                   styleClass="chart">
                            <xAxis><CategoryAxis label="Date"/></xAxis>
                            <yAxis><NumberAxis label="Count"/></yAxis>
                        </LineChart>
                    </VBox>
                </HBox>

                <!-- Assessment table with individual PDF export -->
                <VBox styleClass="card" spacing="14">
                    <Label text="Individual Assessment Reports" styleClass="section-title"/>
                    <TableView fx:id="reportTable" prefHeight="280" styleClass="table-view"
                               style="-fx-background-color: transparent;">
                        <columns>
                            <TableColumn fx:id="colId"     text="#"             prefWidth="60"/>
                            <TableColumn fx:id="colDate"   text="Date"          prefWidth="180"/>
                            <TableColumn fx:id="colSide"   text="Knee Side"     prefWidth="110"/>
                            <TableColumn fx:id="colPain"   text="Pain"          prefWidth="80"/>
                            <TableColumn fx:id="colRisk"   text="Risk"          prefWidth="120"/>
                            <TableColumn fx:id="colExport" text="Export"        prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>

        <HBox styleClass="status-bar" alignment="CENTER_LEFT">
            <Label text="Reports  |  Smart Knee OA  |  Demonstration Use Only" styleClass="status-text"/>
        </HBox>
    </VBox>
</HBox>
