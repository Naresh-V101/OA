<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartkneeoa.frontend.controllers.ResultsController"
      styleClass="base-pane" prefWidth="1200" prefHeight="750">

    <!-- Sidebar -->
    <VBox styleClass="sidebar" spacing="0">
        <VBox styleClass="sidebar-header" spacing="4">
            <Label text="🦵 SmartKneeOA" styleClass="sidebar-logo-text"/>
            <Label text="Assessment System" styleClass="sidebar-subtitle"/>
        </VBox>
        <VBox spacing="0" style="-fx-padding: 12 0 0 0;" VBox.vgrow="ALWAYS">
            <Button text="📊  Dashboard"      onAction="#navDashboard"     styleClass="nav-button"/>
            <Button text="➕  New Assessment" onAction="#navNewAssessment" styleClass="nav-button"/>
            <Button text="📡  Live Monitor"   onAction="#navLiveMonitor"   styleClass="nav-button"/>
            <Button text="📋  History"        onAction="#navHistory"       styleClass="nav-button, nav-button-active"/>
            <Button text="📄  Reports"        onAction="#navReports"        styleClass="nav-button"/>
            <Button text="👤  Profile"        onAction="#navProfile"        styleClass="nav-button"/>
            <Button text="⚙️   Settings"      onAction="#navSettings"       styleClass="nav-button"/>
        </VBox>
        <VBox style="-fx-padding: 0 0 16 0;">
            <Separator/>
            <Button text="🚪  Sign Out" onAction="#logout" styleClass="nav-button" style="-fx-text-fill: #F44336;"/>
        </VBox>
    </VBox>

    <!-- Main Content -->
    <VBox HBox.hgrow="ALWAYS" spacing="0">
        <HBox styleClass="top-bar" alignment="CENTER_LEFT">
            <Label text="Assessment Results" styleClass="top-bar-title" HBox.hgrow="ALWAYS"/>
            <Button text="⬅  Back to History" onAction="#navHistory" styleClass="btn-secondary"
                    style="-fx-padding: 8 16;"/>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
            <VBox spacing="24" style="-fx-padding: 28;">

                <!-- ── Disclaimer ── -->
                <VBox styleClass="disclaimer-box">
                    <Label text="⚠️  MEDICAL DISCLAIMER" style="-fx-text-fill: #F44336; -fx-font-weight: 700; -fx-font-size: 12px;"/>
                    <Label text="This is a PRELIMINARY DEMONSTRATION RESULT generated by a model trained on SYNTHETIC data. It is NOT clinically validated and must NOT be used for medical diagnosis, treatment decisions, or as a substitute for professional medical advice. Always consult a qualified healthcare provider for knee health concerns."
                           styleClass="disclaimer-text" wrapText="true"/>
                </VBox>

                <!-- ── Risk Result Card ── -->
                <HBox spacing="20">
                    <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="14" alignment="CENTER">
                        <Label text="PRELIMINARY RISK CATEGORY" styleClass="card-title"/>
                        <Label fx:id="riskCategoryLabel" text="—"
                               style="-fx-font-size: 42px; -fx-font-weight: 800; -fx-text-fill: #00BFA5;"/>
                        <Label fx:id="riskBadge" text="LOW RISK" styleClass="badge-low"/>
                        <Label fx:id="riskGuidance" text="" styleClass="body-text"
                               wrapText="true" textAlignment="CENTER"/>
                    </VBox>

                    <!-- Probability Bar Chart -->
                    <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="14">
                        <Label text="Prediction Probabilities" styleClass="section-title"/>
                        <BarChart fx:id="probabilityChart" prefHeight="200" animated="false"
                                  styleClass="chart" categoryGap="20">
                            <xAxis><CategoryAxis/></xAxis>
                            <yAxis><NumberAxis label="Probability" lowerBound="0" upperBound="1" tickUnit="0.25"/></yAxis>
                        </BarChart>
                        <Label fx:id="modelVersionLabel" text="Model: —" styleClass="label-muted"/>
                        <Label fx:id="demoBadge" text="⚠️ DEMO – Synthetic Data" style="-fx-text-fill: #FF9800; -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>

                <!-- ── Assessment Details ── -->
                <HBox spacing="20">
                    <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="12">
                        <Label text="Assessment Details" styleClass="section-title"/>
                        <HBox spacing="0">
                            <GridPane hgap="16" vgap="10">
                                <Label text="Assessment ID:" styleClass="label-muted"
                                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Label fx:id="detailId" text="—" styleClass="label-primary"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <Label text="Date &amp; Time:" styleClass="label-muted"
                                       GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Label fx:id="detailDate" text="—" styleClass="label-primary"
                                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                <Label text="Knee Side:" styleClass="label-muted"
                                       GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <Label fx:id="detailSide" text="—" styleClass="label-primary"
                                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                <Label text="Pain Score:" styleClass="label-muted"
                                       GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <Label fx:id="detailPain" text="—" styleClass="label-primary"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                                <Label text="Readings:" styleClass="label-muted"
                                       GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                <Label fx:id="detailReadings" text="—" styleClass="label-primary"
                                       GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                            </GridPane>
                        </HBox>
                    </VBox>

                    <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="12">
                        <Label text="Sensor Feature Summary" styleClass="section-title"/>
                        <TableView fx:id="featureTable" prefHeight="200"
                                   styleClass="table-view" style="-fx-background-color: transparent;">
                            <columns>
                                <TableColumn fx:id="featureNameCol"  text="Feature" prefWidth="200"/>
                                <TableColumn fx:id="featureValueCol" text="Value"   prefWidth="140"/>
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>

                <!-- ── Actions ── -->
                <HBox spacing="14">
                    <Button text="📄  Export PDF Report" onAction="#exportPdf"
                            styleClass="btn-primary" style="-fx-padding: 12 28;"/>
                    <Button text="➕  New Assessment" onAction="#navNewAssessment"
                            styleClass="btn-secondary" style="-fx-padding: 12 28;"/>
                    <Button text="📋  View All History" onAction="#navHistory"
                            styleClass="btn-secondary" style="-fx-padding: 12 28;"/>
                </HBox>

            </VBox>
        </ScrollPane>

        <HBox styleClass="status-bar" alignment="CENTER_LEFT">
            <Label text="Assessment Results  |  Smart Knee OA" styleClass="status-text"/>
        </HBox>
    </VBox>
</HBox>
